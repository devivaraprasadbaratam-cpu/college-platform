generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model College {
  id          String   @id @default(cuid())
  name        String
  location    String
  fees        Int
  rating      Float
  description String
  placements  String
  courses     String
  image       String
  createdAt   DateTime @default(now())
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())

  savedColleges  SavedCollege[]
}

model SavedCollege {
  id         String   @id @default(cuid())
  userId     String
  collegeId  String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}